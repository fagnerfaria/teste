{
  "name": "codigolab",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "node scripts/prepare-assets.mjs && vite build",
    "build:dev": "vite build --mode development",
    "preview": "vite preview",
    "lint": "eslint src",
    "format": "prettier --write .",
    "test": "vitest run src/test",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run lint && npm test && npm run test:content && npm run verify:curriculum && node scripts/worker-security.test.mjs && node scripts/monitor-check.mjs",
    "smoke": "node scripts/smoke.mjs",
    "test:content": "node --test scripts/content-snapshot.test.mjs scripts/mdx-reader.test.mjs",
    "verify:curriculum": "node --import tsx scripts/verify-curriculum.mjs",
    "qa": "node scripts/local-smoke.mjs"
  },
  "overrides": {
    "rolldown": "1.2.1"
  },
